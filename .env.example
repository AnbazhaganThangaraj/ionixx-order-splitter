# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Order splitting
DEFAULT_STOCK_PRICE=100
QUANTITY_PRECISION=3

# Market schedule (POC assumption: US equities, no holiday calendar)
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_TIME=09:30
MARKET_CLOSE_TIME=16:00

# Security
# Production: comma-separated partnerId:sha256hex pairs. Generate with:
#   npm run hash-key -- --generate partner-a
API_KEY_HASHES=
# Local development only: plaintext partnerId:key pairs (keys >= 24 characters).
# With neither set, authentication is disabled; one of them is required in production.
# API_KEYS=partner-a:replace-with-a-long-random-key-123456
API_KEYS=
RATE_LIMIT_MAX=100
PARTNER_RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
IDEMPOTENCY_TTL_SECONDS=86400
# Number of proxies / load balancers in front of the app (0 = none)
TRUST_PROXY=0
